#!/usr/bin/env python3
"""yt-dlp 套件统一入口。

  yt check             检查依赖（yt-dlp 可执行文件 / yt_dlp Python 库 / 环境）
  yt doc <url>         YouTube：探测 → 下载最优字幕 → 洗成文稿
  yt subs <url>        YouTube：只探测并下载字幕
  yt bili <动作> <url> B站字幕探测与文稿底稿生成
  yt clean <file>      只清洗一个已有的 vtt/srt
  yt render <md>       把整理好的成稿 Markdown 渲染为 docx
  yt rm <id|--all>     把临时工作目录移入废纸篓
"""

import argparse
import datetime
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
SCRIPTS = HERE / "scripts"
sys.path.insert(0, str(SCRIPTS))

from common import TMP_ROOT, check_ytdlp_module, find_ytdlp, load_json, video_id_of, workdir  # noqa: E402

BILI = HERE / "skills" / "bilibili-transcript" / "bili"


def run(script, argv):
    return subprocess.run([sys.executable, str(SCRIPTS / script)] + argv).returncode


def cmd_doc(args):
    if run("fetch.py", [args.url]) != 0:
        return 1
    vid = video_id_of(args.url)
    meta = load_json(workdir(vid, create=False) / "meta.json")

    argv = [meta["subtitle_path"], "--kind", meta["subtitle_kind"]]
    if args.no_timestamps:
        argv.append("--no-timestamps")
    if run("clean.py", argv) != 0:
        return 1

    print(f"工作区 {meta['workdir']}")
    print(f"下一步 {'需要翻译（非中文）' if meta['needs_translation'] else '中文字幕，无需翻译'}"
          f"　成稿后 yt render 出 docx，写完记得 yt rm {vid}")
    return 0


def cmd_subs(args):
    return run("fetch.py", [args.url] + (["--json"] if args.json else []))


def cmd_clean(args):
    argv = [args.file, "--kind", args.kind]
    if args.no_timestamps:
        argv.append("--no-timestamps")
    return run("clean.py", argv)


def cmd_bili(args):
    argv = [args.action, args.url]
    if args.json:
        argv.append("--json")
    return subprocess.run([sys.executable, str(BILI), *argv]).returncode


def cmd_check(args):
    """检查依赖与运行环境，让 agent / 用户一眼看出缺什么、怎么装。"""
    ok = True

    pyver = sys.version_info
    print(f"Python   {pyver.major}.{pyver.minor}.{pyver.micro}　{sys.executable}")
    if pyver < (3, 9):
        print("         版本过旧：本套件需要 Python 3.9+")
        ok = False
    else:
        print("         满足要求（3.9+）")

    try:
        ytdlp, ver = find_ytdlp()
        print(f"yt-dlp   {ver}　{ytdlp}")
    except SystemExit:
        ok = False

    module_ok, module_msg = check_ytdlp_module()
    print(f"yt_dlp库 {'✅ ' + module_msg if module_ok else '❌ ' + module_msg}")
    ok = ok and module_ok

    try:
        import docx  # noqa: F401
        print("docx库   ✅ 已安装（python-docx）")
    except Exception:
        print("docx库   ❌ 未安装 python-docx（yt render 生成 docx 需要）。\n"
              "         安装：python3 -m pip install -U python-docx")
        ok = False

    print(f"临时区   {TMP_ROOT}（YT_TMP_ROOT 可覆盖）")
    try:
        TMP_ROOT.mkdir(parents=True, exist_ok=True)
        probe = TMP_ROOT / ".write-test"
        probe.write_text("ok", encoding="utf-8")
        probe.unlink()
        print("         可写")
    except Exception as exc:
        print(f"         不可写：{exc}")
        ok = False

    outdir = _output_dir()
    print(f"成稿目录 {outdir}（YT_OUTPUT_DIR 可覆盖）")
    try:
        outdir.mkdir(parents=True, exist_ok=True)
        print("         可写")
    except Exception as exc:
        print(f"         不可写：{exc}")
        ok = False

    print()
    if ok:
        print("全部就绪，可以开始整理文稿。")
        return 0
    print("存在缺失项，请按上面的安装命令补齐后重跑 yt check。")
    return 1


def _output_dir():
    env = os.environ.get("YT_OUTPUT_DIR")
    if env:
        return Path(env).expanduser()
    return Path.cwd() / "yt-transcript-output"


def _safe_name(title):
    return re.sub(r'[\\/:*?"<>|\r\n]+', "_", title).strip() or "未命名"


def _title_from_md(path):
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return None


def cmd_render(args):
    """把整理好的成稿 Markdown 渲染成 docx，落到成稿目录。"""
    src = Path(args.input).expanduser()
    if not src.exists():
        print(f"找不到文件：{src}", file=sys.stderr)
        return 1
    try:
        import docx  # noqa: F401
    except Exception:
        print("缺少 python-docx。安装：python3 -m pip install -U python-docx", file=sys.stderr)
        return 1
    title = args.title or _title_from_md(src) or src.stem
    out = Path(args.out).expanduser() if args.out else _output_dir() / f"{_safe_name(title)}.docx"
    out.parent.mkdir(parents=True, exist_ok=True)
    ret = run("render_docx.py", [str(src), "-o", str(out)])
    if ret == 0:
        print(f"✓ 成稿已落盘：{out}")
    return ret


def _trash_dir():
    """返回本平台的废纸篓/可恢复删除目录。"""
    if sys.platform == "darwin":
        return Path.home() / ".Trash"
    if sys.platform == "win32":
        base = os.environ.get("LOCALAPPDATA") or str(Path.home() / "AppData" / "Local")
        return Path(base) / "yt-transcript-trash"
    data = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
    return Path(data) / "Trash" / "files"


def move_to_trash(path):
    """把精确目标移入废纸篓，避免不可恢复删除。"""
    trash = _trash_dir()
    trash.mkdir(parents=True, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    target = trash / f"{path.name}-{stamp}"
    index = 1
    while target.exists():
        target = trash / f"{path.name}-{stamp}-{index}"
        index += 1
    shutil.move(str(path), str(target))
    return target


def cmd_rm(args):
    if args.all:
        if TMP_ROOT.exists():
            target = move_to_trash(TMP_ROOT)
            print(f"已移入废纸篓（可恢复） {target}")
        else:
            print("工作区本来就是空的")
        return 0
    if not args.target:
        print("要么给 video_id，要么给 --all", file=sys.stderr)
        return 1
    d = TMP_ROOT / video_id_of(args.target)
    if d.exists():
        target = move_to_trash(d)
        print(f"已移入废纸篓（可恢复） {target}")
    else:
        # 多P视频的默认第一页工作区是 <BV>_p1；给裸 BV 号时一并匹配。
        matches = sorted(TMP_ROOT.glob(f"{d.name}_p*")) if re.fullmatch(r"BV[0-9A-Za-z]{10}", d.name) else []
        if not matches:
            print(f"没这个目录：{d}")
            return 0
        for match in matches:
            target = move_to_trash(match)
            print(f"已移入废纸篓（可恢复） {target}")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="yt", description="YouTube / B站字幕与文稿工具")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("check", help="检查依赖与运行环境")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("doc", help="YouTube：下字幕并洗成文稿（一步到位）")
    p.add_argument("url")
    p.add_argument("--no-timestamps", action="store_true")
    p.set_defaults(func=cmd_doc)

    p = sub.add_parser("subs", help="YouTube：只下字幕")
    p.add_argument("url")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_subs)

    p = sub.add_parser("clean", help="只清洗已有字幕文件")
    p.add_argument("file")
    p.add_argument("--kind", choices=["auto", "manual"], default="auto")
    p.add_argument("--no-timestamps", action="store_true")
    p.set_defaults(func=cmd_clean)

    p = sub.add_parser("bili", help="B站：登录探测、下载字幕、生成文稿底稿")
    p.add_argument("action", choices=["probe", "subs", "doc"])
    p.add_argument("url")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_bili)

    p = sub.add_parser("render", help="把整理好的成稿 Markdown 渲染为 docx")
    p.add_argument("input", help="成稿 Markdown 文件路径")
    p.add_argument("--title", default=None, help="文件名标题（默认取 md 的一级标题）")
    p.add_argument("--out", default=None, help="指定输出 docx 路径")
    p.set_defaults(func=cmd_render)

    p = sub.add_parser("rm", help="把临时工作目录移入废纸篓")
    p.add_argument("target", nargs="?", help="video_id 或视频 URL")
    p.add_argument("--all", action="store_true")
    p.set_defaults(func=cmd_rm)

    args = ap.parse_args()
    sys.exit(args.func(args))


if __name__ == "__main__":
    main()
